# ==========================================
# AI Chatbot Application Environment Template
# Copy this file to .env.local and populate with your credentials
# ==========================================

# 1. OpenAI API Configuration (Required for AI responses)
# Obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Default AI Model (gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom OpenAI compatible endpoint (e.g., Azure or local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Supabase Configuration (Optional: Required for persistent cloud authentication & chat history)
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
